@page
@model test.Pages.TransactionsModel
@{
    ViewData["Title"] = "История на транзакциите";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>История на транзакциите</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Дата и час</th>
                        <th>Актив</th>
                        <th>Тип</th>
                        <th>Количество</th>
                        <th>Цена</th>
                        <th class="pe-4 text-end">Общо</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TransactionHistory)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@t.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-bold">@t.AssetName</td>
                            <td>
                                <span class="@Model.GetTransactionBadgeClass(t.Type)">
                                    @t.Type
                                </span>
                            </td>
                            <td>@t.Amount</td>
                            <td>$@((t.Type == "Deposit") ? 1.ToString("N2") : t.PriceAtTime.ToString("N2"))</td>
                            <td class="pe-4 text-end fw-bold">$@((t.Type == "Deposit") ? (t.Amount).ToString("N2") : (t.Amount * t.PriceAtTime).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>